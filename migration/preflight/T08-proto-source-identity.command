bash -c $'\nset -u\nMC=$(go env GOMODCACHE)\necho "module cache (read-only source): $MC"\nP="$MC/github.com/tx7do/go-crud/api@v0.0.7/protos/pagination/v1/pagination.proto"\n[ -f "$P" ] || { echo "pristine proto not in the read-only module cache"; exit 1; }\necho "upstream : $(sha256sum "$P")"\necho "local    : $(sha256sum api/localdeps/pagination/pagination/v1/pagination.proto)"\ncmp "$P" api/localdeps/pagination/pagination/v1/pagination.proto\necho "cmp exit=$? (0 = byte-identical)"\necho "lines: $(wc -l < api/localdeps/pagination/pagination/v1/pagination.proto)"\necho "in-file option go_package kept verbatim (localization happens in the generator):"\ngrep -n "option go_package" api/localdeps/pagination/pagination/v1/pagination.proto\n' 
