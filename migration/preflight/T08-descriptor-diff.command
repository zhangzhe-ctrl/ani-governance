bash -c $'\nset -u\nU=migration/preflight/T08-descriptor-upstream.log\nL=migration/preflight/T08-descriptor-local.log\necho "structural lines: upstream=$(wc -l < $U) local=$(wc -l < $L)"\nd=$(diff "$U" "$L" | grep -c "^[<>]")\necho "differing text lines: $d"\necho "--- the only semantic difference allowed by the register ---"\ndiff "$U" "$L" | grep "^[<>]" | grep -v "runtime re-marshal"\necho "--- re-marshal size delta (go_package string length) ---"\ngrep -h "runtime re-marshal" "$U" "$L"\nif [ "$d" != "4" ]; then echo "FAIL: unexpected descriptor drift"; exit 1; fi\ndiff "$U" "$L" | grep "^[<>]" | grep -v "runtime re-marshal" | grep -q "options.go_package" || { echo "FAIL: no go_package line"; exit 1; }\necho "OK: descriptor differs only in the registered options.go_package (plus its byte-length effect on the re-marshal line)"\n' 
