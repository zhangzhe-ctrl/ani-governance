+FRAMEWORK_ONLY = re.compile(r"^(--- (FAIL|PASS|SKIP)\b|=== (RUN|PAUSE|CONT)\b|FAIL\s|ok\s|Elapsed:|"
+                            r"Testing\.|Coverage:|\s*$)")
+WRAPPER_HEAD = re.compile(r"^(WARNING: DATA RACE|Read at 0x|Write at 0x|Previous (atomic )?write at 0x|"
+                          r"Previous read at 0x|Goroutine \d+ \(|created by |\t?0x[0-9a-f]+ |==+|"
+                          r"<autogenerated>:\d+ \+0x[0-9a-f]+$)")
+FILE_IN_LINE = re.compile(r"[\w./+-]+\.(?:go|s)(?=[:\s]|$)")
+# a race report prints "path/file.go:16 +0x28" and "pkg/path.Func(args)" frames
+FILE_FRAME = re.compile(r"^(\S+\.(?:go|s)):(\d+) \+0x[0-9a-f]+$")
+SYMBOL_FRAME = re.compile(r"^([\w./+-]+\.[^\s]*\([^)]*\))(\s|$)")
+
+
+def is_wrapper(line):
+    """Framework lines that surround a result and carry no verdict of their own."""
+    return bool(FRAMEWORK_ONLY.match(line.strip()))
+
+
+def is_race_frame_line(line, frame_files, frame_symbols=()):
+    """True for a line of a race report that stays inside the examined code and the runtime.
+
+    A file frame is accepted only when the file is one of the examined files; a symbol frame is
+    accepted only when its package is one of the examined packages. Anything else is a finding.
+    """
+    stripped = line.strip()
+    if WRAPPER_HEAD.match(stripped):
+        for name in FILE_IN_LINE.findall(stripped):
+            if not any(name.endswith(f) or ("/%s/" % f) in name for f in frame_files):
+                return False
+        return True
+    file_frame = FILE_FRAME.match(stripped)
+    if file_frame:
+        name = file_frame.group(1)
+        return any(name.endswith(f) or ("/%s/" % f) in name for f in frame_files)
+    symbol_frame = SYMBOL_FRAME.match(stripped)
+    if symbol_frame and frame_symbols:
+        return any(symbol_frame.group(1).startswith(p) for p in frame_symbols)
+    return False
+
