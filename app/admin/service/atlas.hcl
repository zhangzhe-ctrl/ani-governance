// Use scripts/atlas.sh: Ent's loader must run under app/admin/service because
// the schema lives in a Go internal package. schema.sql is generated by cmd/schema
// after Ent generation, including the tenant-preserving composite FK. Applying
// migrations needs only Atlas; it never requires a Go compiler in the runtime.
env "governance" {
  src = "file://schema.sql"
  url = getenv("ANI_DATABASE_DSN")
  dev = getenv("ANI_ATLAS_DEV_DSN")
  migration {
    dir = "file://../../../migrations"
  }
}
