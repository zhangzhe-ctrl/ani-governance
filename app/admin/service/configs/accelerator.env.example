# Optional read/management client. An empty address disables Accelerator access.
# Enabled configuration requires every TLS input. No plaintext fallback.
ANI_ACCELERATOR_ADDR=127.0.0.1:19093
ANI_ACCELERATOR_SERVER_NAME=ani-accelerator-service
ANI_ACCELERATOR_CA=/etc/ani-governance/accelerator/ca.pem
ANI_ACCELERATOR_CERT=/etc/ani-governance/accelerator/governance.pem
ANI_ACCELERATOR_KEY=/etc/ani-governance/accelerator/governance-key.pem
ANI_ACCELERATOR_TIMEOUT=3s
# Client leaf: exactly one URI SAN spiffe://ani.internal/service/ani-governance.
# Server DNS SAN must match ANI_ACCELERATOR_SERVER_NAME using the managed CA.
# Accelerator's separate deployment config must explicitly grant each actor's
# action and exact cluster/tenant scope. This file grants no downstream access.
# No production GPU owner is registered by these management settings.
